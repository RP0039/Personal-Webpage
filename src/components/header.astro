---
import HomeIcon from "@assets/svg/hamburger.svg";
import BlogIcon from "@assets/svg/newspaper.svg";
import LogIcon from "@assets/svg/paperclip.svg";

const { Lang } = Astro.props;

import { getRelativeLocaleUrl } from "astro:i18n";
import es from "@i18n/es";
import en from "@i18n/en";
import type { Language } from "@type/language.type";

const lang = (Lang ?? Astro.params.lang) as Language;
const translations = { es, en };
const t = translations[lang];
---

<header id="#top">
    <a href={getRelativeLocaleUrl(Lang, '/')} class="hover:rotate-2 hover:translate-x-1.5 hover:scale-102">
        <h1 class="font-bold">RP0039<span class="text-xl">V-3.22</span></h1>
    </a>
    <ul>
        <li><a href={getRelativeLocaleUrl(Lang, '/home')} class="hover:scale-105"><HomeIcon class="size-6 font-medium" />{t.header.home}</a></li>
        <li><a href={getRelativeLocaleUrl(Lang, '/blog')} class="hover:scale-105"><BlogIcon class="size-6 font-medium" />{t.header.blog}</a></li>
        <li><a href={getRelativeLocaleUrl(Lang, '/log')} class="hover:scale-105"><LogIcon class="size-6 font-medium" />{t.header.log}</a></li>
    </ul>
</header>