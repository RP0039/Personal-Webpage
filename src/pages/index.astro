---
import '@styles/global.css';
import '@styles/colors.css';
import '@styles/fonts.css';
import { Image } from 'astro:assets'
import RG from "@assets/img/RG.png";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Doto:wght@100..900&family=Jacquard+12&display=swap" rel="stylesheet">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP0039 | Welcome :3</title>
</head>
<body class="md:relative grid justify-items-center items-center">
    <main class="relative rounded-lg max-w-[90%]">
        <h1 class="absolute text-7xl md:text-8xl text-center Doto">.:RP0039:.</h1>
        <h3 class="absolute text-nowrap">Layout.V1 - 2026-08-06</h3>
        <h2 class="py-2 border bg-(--d-bg) shadow-(--box-shadow) text-center text-2xl font-bold underline px-7 mb-3">Welcome! to my dream</h2>
        <Image id="RG" class="md:h-96 md:max-w-67" src={RG} alt="'Red Guy' from the tv show Don't Hug me I'm Scared" />
        <p class="mb-2 text-center font-medium sm:text-xl">Elige tu idioma!</p>
        <div class="items-center flex flex-col gap-1.5">
            <a href="/es">
                <button class="bt">🇦🇷 SPANISH 🇪🇸</button>
            </a>
            <a href="/en">
                <button class="bt">🇬🇧 ENGLISH 🇺🇸</button>
            </a>
        </div>
    </main>
</body>
</html>

<style>
    h3 {
        color: var(--color-alt);
        position: absolute;
        right: -15;
        bottom: -35;
        z-index: -1;
    }   
    #RG {
        position: absolute;
        left: 0;
        top: -190;
        z-index: -2;
    }   
    .bt {
        display: block;
        box-shadow: var(--box-shadow);
        padding: 1rem 1.3rem;
        background-color: var(--l-bg);
        transition: var(--transition);
    }
    .bt:hover {
        background-color: var(--color-alt);
        color: hsl(147, 78, 45);
    }
    main {
        padding: 1rem 1.1rem;
        background-color: var(--b-bg);
        border: var(--border-card);
        box-shadow: var(--box-shadow);
    }
    body {
        overflow-y: hidden;
        grid-template-rows: 1fr;
        background-color: var(--d-bg);
        height:100%;
        max-height: 100vh;
        max-height: 100dvh;
        padding: 0;
        margin: 0;
    }
    @media screen and (max-width: 768px) {
        body {
            margin-top: 6rem;
        }
        h1 {
            position: absolute;
            left: 0;
            top: -95%;
            z-index: 9;
        }
        h3 {
            position: absolute;
            right: 0;
            bottom: -35;
        }           
        .H1 {
            display: none;
        }        
    }
    @media screen and (min-width: 400px) {
        h1 {
            top: -110%;
        }
    }
@media screen and (min-width: 769px) {
    #RG {
    position: absolute;
    left: -72%;
    top: -130;
    }  
    h1 {
    position: absolute;
    left: 25;
    top: -127;
    }
}
</style>