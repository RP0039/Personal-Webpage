---
import Layout from "@layout/layout.astro"
import Totop from "@components/toTop.astro"
import Topic from "@components/home/carrusel.astro";

import VideoGames from "@assets/img/home/homepage.png";
import { Image } from 'astro:assets'

import Music from "@components/Music.astro";
const songData = [
	{
		img: "https://files.catbox.moe/uvbao8.gif",
		mp3: "https://files.catbox.moe/7pte0t.mp3",
		altmusic: "Allow to be Happy - Gustavo Santaolalla"
	},
    {
		img: "https://files.catbox.moe/uvbao8.gif",
		mp3: "https://files.catbox.moe/7pte0t.mp3",
		altmusic: "Allow to be Happy - Gustavo Santaolalla"
	},
    {
		img: "https://files.catbox.moe/uvbao8.gif",
		mp3: "https://files.catbox.moe/7pte0t.mp3",
		altmusic: "Allow to be Happy - Gustavo Santaolalla"
	},
]
// idioma
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import es from "@i18n/es";
import en from "@i18n/en";
import type { Language } from "@type/language.type";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---

<Layout title={t.home.headtitle} lang={lang}>
    <main class="mx-[2%] py-4 px-2">
        <h1>{t.home.title}</h1>
        <section class="text-center py-3" aria-label="Video Games recommendations section">
                <h2>{t.home.subtitle1} <span class="text-black">{t.home.subtitle1}</span> {t.home.subtitle1}</h2>
                <article class="flex justify-center gap-3" aria-label="My favorite games">
                    <Image class="topic" src={VideoGames} alt="A amazing game picture" />
                    <Image class="max-w-47 w-full" src={VideoGames} alt="A amazing game picture" />
                    <Image class="max-w-57 w-full" src={VideoGames} alt="A amazing game picture" />
                    <Image class="max-w-47 w-full" src={VideoGames} alt="A amazing game picture" />
                    <Image class="topic" src={VideoGames} alt="A amazing game picture" />
                </article>
                <article class="flex justify-center gap-3 mt-3" aria-label="Recommendations">
                    <Topic>
                        <Image class="topic" src={VideoGames} alt="A amazing game picture" />                        
                    </Topic>
                </article>
        </section>        
        <section class="text-center" aria-label="Music recommendations section">
                <h2>{t.home.subtitle2} <span class="text-black">{t.home.subtitle2}</span> {t.home.subtitle2}</h2>
                <article class="flex flex-wrap justify-center gap-4">
                    <Music playlist={songData} />
                </article>
        </section>
    </main>

    <Totop />  

</Layout>

<style>
    main h1, h2 {
        font-size: 2rem;
        text-align: center;
        font-weight: 700;
        line-height: 4.5rem;
    }
    h2  {
        border-top: 1.3px solid var(--border);
        color: var(--text-muted);
        font-size: 1rem;
    }
    main {
        background-color: var(--b-bg);
    }
    .topic {
        height: 6rem;
        max-width: 4rem;
        width: 100%;
    }
    @media screen and (min-width: 1000px) {
        body {
            margin: 0 10%;
        }
        .topic {
            height: 16rem;
            max-width: 10rem;
            width: 100%;
        }
        main h1 {
            font-size: 5rem;
        }
        h2 {
            font-size: 2.5rem;
        }
    }
</style>