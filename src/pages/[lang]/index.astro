---
import Layout from '@layout/layout.astro';

import Main from '@components/index/main.astro';
import Stamps from '@components/index/stamps.astro';

import ExtraIcon from "@assets/svg/extras.svg";
import Itsme from "@assets/img/It's me.jpg";
import { Image } from 'astro:assets'

import Music from '@components/Music.astro';

import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

console.log("Fechas crudas:", posts.map(p => ({ title: p.data.title, date: p.data.date })));

const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  return dateB - dateA; 
});

const latestPost = sortedPosts[0];

const imageModules = import.meta.glob<{ default: { src: string } }>(
    '/src/assets/img/blog/*.{jpg,jpeg,png,webp,avif}',
    { eager: true }
);

const normalizedImgPath = latestPost.data.img ? (latestPost.data.img.startsWith('/') ? latestPost.data.img : `/${latestPost.data.img}`) : '';
const imageSrc = imageModules[normalizedImgPath]?.default?.src;

const songData = [
	{
		img: "https://files.catbox.moe/uvbao8.gif",
		mp3: "https://files.catbox.moe/7pte0t.mp3",
		altmusic: "Allow to be Happy - Gustavo Santaolalla"
	}
]

import { getAbsoluteLocaleUrl } from 'astro:i18n';
export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

import es from "@i18n/es";
import en from "@i18n/en";
import type { Language } from "@type/language.type";

export const defaultRedirect = "/es";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---

<Layout title={t.index.headtitle} lang={lang}>
	<section
	 class="grid grid-cols-1 px-[5%] py-6 gap-6"
	>
		<Main>
			<article>
				<h1 class="sm:py-3 text-left text-3xl md:text-4xl font-bold">{t.index.main.title}</h1>
				<span class="flex flex-col gap-2 pl-4 text-pretty text-lg">
					<p> {t.index.main.p1} <span class="text-lg sm:text-xl font-bold underline">RP0039</span> {t.index.main.p2}</p>
					<p>	{t.index.main.p3}</p>
					<p> {t.index.main.p4}</p>
				</span>
			</article>
			<div class="lg:justify-self-end md:mr-2 lg:mr-4">
				<Image id="itme" class="size-34" src={Itsme} alt={t.index.itme} />
				<h1 class="text-center text-2xl font-semibold">{t.index.itme}</h1>
			</div>
			<Stamps 
			url={[
				"https://adriansblinkiecollection.neocities.org/stamps/d18.gif",
				"https://media1.tenor.com/m/DOrW_R3TANcAAAAC/gn-my-pookie-wookie-good-night-my-pookie-wookie.gif",
				"https://media.tenor.com/NG4r1TLxjRkAAAAi/murder-drones-n-plushie.gif",
				"https://media1.tenor.com/m/pM0ki7A-LhcAAAAC/n-sd-n.gif", "https://adriansblinkiecollection.neocities.org/stamps/i7.png", "https://adriansblinkiecollection.neocities.org/stamps/d43.gif", "https://adriansblinkiecollection.neocities.org/stamps/e93.gif", "https://adriansblinkiecollection.neocities.org/stamps/i30.gif", "https://files.catbox.moe/wlcc1t.gif", "https://files.catbox.moe/j5695m.gif"
			]}			
			/>
			<span class="col-span-full lg:px-4 gap-6 md:gap-3 grid md:grid-cols-2">
				<Music playlist={songData} />					
				{latestPost ? (
				<article class="border-(--border) border latest-post-card rounded-lg">
				{imageSrc && <img class="object-cover size-30 h-full lg:w-35" src={imageSrc} alt={latestPost.data.title} />}
				<div style="border-radius: 0 8px 8px 0;" class="w-full">
				<span class="text-[0.875rem] text-(--text-muted)">{latestPost.data.date}</span>
				<h2 class="mt-2 text-2xl font-semibold">
					<a class="hover:underline" href={getAbsoluteLocaleUrl(lang, `/blog/${latestPost.id}`)}>{latestPost.data.title}</a>
				</h2>
				<p>{latestPost.data.description}</p>

				<a href={getAbsoluteLocaleUrl(lang, `/blog/${latestPost.id}`)} class="inline-block mt-4 text-center text-(--color-alt) font-semibold underline">{t.index.RecentPost}</a>
				</div>
				</article>
				) : (
					<p>{t.index.noRecentPosts}</p>
				)}
			</span>
		</Main>
	</section>
	<footer id="Extra" class="py-5 flex justify-center">
		<a class="font-bold text-3xl button rounded px-3.5 py-2.5 hover:scale-110 flex items-center gap-4" href={getAbsoluteLocaleUrl(lang, '/extras')}>{t.index.extra}<ExtraIcon class="size-8"/></a>		
	</footer>
</Layout>

<style>
.latest-post-card {
	overflow: hidden;
	display: flex;
	justify-content: center;
	box-shadow: var(--box-shadow);
}
section {
	background-color: var(--b-bg);
}
div {
	background: var(--gradient);
	background-color: var(--b-bg);
	border: var(--border-card);
	box-shadow: var(--box-shadow);
	padding: 2% 2% 0;
}
#itme {
	border: 0.4px solid hsla(0,0,0,0.4);
}
@media screen and (max-width: 768px) {
	p {
		font-size: 14px;
	}
}
</style>
